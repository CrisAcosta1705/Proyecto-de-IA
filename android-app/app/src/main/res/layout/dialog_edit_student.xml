<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/student_name_hint"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editStudentNameEditText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_background"
        android:hint="@string/student_name_hint"
        android:inputType="textPersonName"
        android:maxLength="150"
        android:paddingHorizontal="14dp"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/student_sex_label"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/editStudentSexSpinner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_background" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/face_reference_actions"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <Button
        android:id="@+id/viewFaceReferencesButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:drawableStart="@android:drawable/ic_menu_gallery"
        android:text="@string/view_face_references" />

    <Button
        android:id="@+id/updateFaceReferencesButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:drawableStart="@android:drawable/ic_menu_camera"
        android:text="@string/update_face_references" />

    <Button
        android:id="@+id/clearFaceReferencesButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/delete_recognition" />

    <Button
        android:id="@+id/deleteStudentPermanentlyButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="@string/delete_student_permanently"
        android:textColor="@color/danger" />

    </LinearLayout>
</ScrollView>
