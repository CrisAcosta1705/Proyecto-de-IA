<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PoseStatus">
        <item name="android:layout_height">42dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pose_pending_background</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="BottomNavigationButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/nav_button_background</item>
        <item name="android:padding">4dp</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
